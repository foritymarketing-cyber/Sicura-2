# Sicura Sicherheitstechnik — Server-Konfiguration
# Quelle der Vorgaben: Notion "07 – Sicherheits- & Kostenkonzept", "03 – Content- & URL-Inventar", "14 – Sitemap".

# --- HTTPS erzwingen, kanonischer Host ohne "www" -----------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.sicura-sicherheitstechnik\.de$ [NC]
  RewriteRule ^ https://sicura-sicherheitstechnik.de%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Security-Header ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# --- Angriffsfläche minimieren ---------------------------------------------
Options -Indexes
Options -MultiViews

<FilesMatch "(^\.|\.(env|md|log|lock|json5?|ya?ml|config|bak|backup|sql|sh)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/\.git [NC]
  RewriteRule ^ - [F]
</IfModule>

<FilesMatch "^(mail-config\.php|mail-config\.example\.php)$">
  Require all denied
</FilesMatch>

# --- 404 --------------------------------------------------------------
# Astro erzeugt aus src/pages/404.astro immer /404.html (unabhaengig von
# trailingSlash), deshalb hier ohne Slash referenzieren.
ErrorDocument 404 /404.html

