---
interface Item { question: string; answer: string }
interface Props { items: Item[] }
const { items } = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<div class="faq" data-reveal-group>
  {items.map((item) => (
    <details class="faq-item" data-reveal>
      <summary>
        {item.question}
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="faq-chevron">
          <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="faq-content">
        <div class="faq-content-inner">
          <p>{item.answer}</p>
        </div>
      </div>
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .faq { border-top: var(--border); }
  .faq-item { border-bottom: var(--border); padding-block: var(--s-4); }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    cursor: pointer;
    font-weight: 500;
    color: var(--c-ink-900);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-chevron { transition: transform var(--m-base) var(--m-ease); flex-shrink: 0; }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }

  /*
    Native details/summary, ohne JavaScript animiert: die UA setzt
    geschlossene Inhalte auf display:none, unsere Regel hier (Autor-CSS
    schlägt User-Agent-CSS) ersetzt das durch eine Grid-Rows-Transition.
  */
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--m-base) var(--m-ease);
  }
  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }
  .faq-content-inner {
    overflow: hidden;
  }
  .faq-content-inner p {
    margin-top: var(--s-3);
    color: var(--c-ink-600);
  }
</style>
