---
import { site } from '../lib/site';
---

<a class="sticky-call" href={site.phoneHref}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.2 1.1L6.6 10.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
  <span>Jetzt anrufen: {site.phoneDisplay}</span>
</a>

<style>
  .sticky-call {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    height: 56px;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--c-accent-600);
    color: #fff;
    font-weight: 500;
  }
  @media (min-width: 768px) {
    .sticky-call { display: none; }
  }
</style>
