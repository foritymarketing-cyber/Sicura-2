---
// Randabfallende Bildzeile — Notion "18", Abschnitt 5: mindestens zwei
// Sektionen pro Seite brechen aus dem Raster aus. Bewusst kein Foto (keine
// dokumentierte Lizenz vorhanden), stattdessen dieselbe lizenzfreie
// Linien-Grafik wie im Hero und in den ServiceBlocks — zeigt die drei
// Leistungen als ein zusammenhängendes System.
---

<section class="visual-band" aria-hidden="true" data-reveal>
  <svg viewBox="0 0 1200 200" preserveAspectRatio="none" class="visual-band-svg">
    <rect width="1200" height="200" fill="var(--c-primary-50)" />
    <line x1="0" y1="100" x2="1200" y2="100" stroke="var(--c-line)" stroke-width="1" stroke-dasharray="2 10" />

    <g transform="translate(190,52)">
      <line x1="30" y1="96" x2="30" y2="48" stroke="var(--c-line)" stroke-width="1" />
      <rect x="0" y="0" width="60" height="34" rx="1" fill="var(--c-paper-0)" stroke="var(--c-ink-900)" stroke-width="1.5" />
      <circle cx="30" cy="17" r="9" fill="none" stroke="var(--c-ink-900)" stroke-width="1.5" />
      <circle cx="30" cy="17" r="3" fill="var(--c-primary-700)" />
    </g>

    <g transform="translate(570,96)">
      <line x1="30" y1="0" x2="30" y2="48" stroke="var(--c-line)" stroke-width="1" />
      <rect x="5" y="48" width="50" height="36" rx="1" fill="var(--c-paper-0)" stroke="var(--c-ink-900)" stroke-width="1.5" />
      <circle cx="30" cy="66" r="9" fill="none" stroke="var(--c-ink-900)" stroke-width="1.5" />
      <path d="M30 66 L30 60 M30 66 L35 69" stroke="var(--c-ink-900)" stroke-width="1.5" stroke-linecap="round" />
    </g>

    <g transform="translate(970,52)">
      <line x1="30" y1="96" x2="30" y2="48" stroke="var(--c-line)" stroke-width="1" />
      <path d="M50 12 a14 14 0 1 0-9 22 L18 57 a5.5 5.5 0 0 0 7.5 7.5 l23-23 a14 14 0 0 0 1.5-24.5Z" fill="var(--c-paper-0)" stroke="var(--c-ink-900)" stroke-width="1.5" stroke-linejoin="round" />
    </g>
  </svg>
</section>

<style>
  .visual-band {
    line-height: 0;
  }
  .visual-band-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 220px;
  }
</style>
